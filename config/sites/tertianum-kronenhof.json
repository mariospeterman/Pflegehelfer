  "workflows": {
    "nursing-day": {
      "name": "Pflegetag",
      "eligibleRoles": ["care-assistant", "registered-nurse"],
      "version": 2,
      "definition": {
        "schemaVersion": 1,
        "steps": [
          {
            "id": "handover",
            "kind": "handover",
            "title": "Teamübergabe",
            "prompt": "Übergabe für mein Team"
          },
          {
            "id": "prioritize",
            "kind": "work-queue",
            "title": "Mein Tagesplan",
            "prompt": "Zeig mir meine sechs Patientinnen und Patienten"
          },
          {
            "id": "patient",
            "kind": "context-selection",
            "title": "Patient wählen",
            "prompt": "Mit wem beginne ich?"
          },
          {
            "id": "work",
            "kind": "work-queue",
            "title": "Versorgen",
            "prompt": "Was ist hier geplant und offen?"
          },
          {
            "id": "document",
            "kind": "documentation",
            "title": "Im Gespräch dokumentieren",
            "prompt": "Was wurde gemacht oder beobachtet?"
          },
          {
            "id": "communicate",
            "kind": "work-queue",
            "title": "Im Team klären",
            "prompt": "Welche @Fragen und Kommentare sind offen?"
          },
          {
            "id": "review",
            "kind": "review",
            "title": "Kurz prüfen",
            "prompt": "Welche Änderungen warten auf meine Freigabe?"
          },
          {
            "id": "prepare-handover",
            "kind": "handover",
            "title": "Nächste Schicht",
            "prompt": "Was muss ich übergeben?"
          },
          {
            "id": "reconcile",
            "kind": "reconciliation",
            "title": "Abgleich prüfen",
            "prompt": "Ist alles sicher synchronisiert?"
          },
          {
            "id": "complete",
            "kind": "completion",
            "title": "Verantwortung übertragen",
            "prompt": "Arbeitstag abschliessen"
          }
        ]
      }
    },
    "physician-rounds": {
      "name": "Ärztliche Runde",
      "eligibleRoles": ["physician"],
      "version": 1,
      "definition": {
        "schemaVersion": 1,
        "steps": [
          {
            "id": "questions",
            "kind": "work-queue",
            "title": "Anfragen",
            "prompt": "Welche Teamfragen sind offen?"
          },
          {
            "id": "patient",
            "kind": "context-selection",
            "title": "Patient wählen",
            "prompt": "Patientenkontext wählen"
          },
          {
            "id": "evidence",
            "kind": "orientation",
            "title": "Evidenz prüfen",
            "prompt": "Patientenprofil und letzte Vitalwerte"
          },
          {
            "id": "decision",
            "kind": "review",
            "title": "Antwort oder Folgeauftrag",
            "prompt": "Antwort vorbereiten"
          },
          {
            "id": "complete",
            "kind": "completion",
            "title": "Runde abschliessen",
            "prompt": "Runde abschliessen"
          }
        ]
      }
    },
    "support-day": {
      "name": "Fachauftrag",
      "eligibleRoles": [
        "pharmacy",
        "physiotherapy",
        "occupational-therapy",
        "transport",
        "service",
        "administration",
        "management",
        "hr",
        "it",
        "quality-safety"
      ],
      "version": 1,
      "definition": {
        "schemaVersion": 1,
        "steps": [
          {
            "id": "orientation",
            "kind": "orientation",
            "title": "Orientierung",
            "prompt": "Was ist heute wichtig?"
          },
          {
            "id": "assigned-work",
            "kind": "work-queue",
            "title": "Zugewiesene Arbeit",
            "prompt": "Meine offenen Aufgaben"
          },
          {
            "id": "complete",
            "kind": "completion",
            "title": "Abschliessen",
            "prompt": "Arbeit abschliessen"
          }
        ]
      }
    }
  },
