# Copy only for local synthetic development. Use a secret manager in deployment.
PFH_OPERATIONAL_DATABASE_URL=postgresql://pflegehelfer:replace-me@127.0.0.1:5434/pflegehelfer
PFH_FHIR_BASE_URL=http://127.0.0.1:8103/
MEDPLUM_APP_BASE_URL=http://127.0.0.1:3001/
MEDPLUM_DEFAULT_SUPER_ADMIN_CLIENT_ID=
MEDPLUM_DEFAULT_SUPER_ADMIN_CLIENT_SECRET=
# Production uses a least-privilege ClientApplication; bootstrap credentials
# above are accepted only in explicit synthetic demo mode.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Secret-manager value with at least 32 bytes. See DEPLOYMENT.md for rotation.
PFH_CHECKPOINT_HMAC_KEY=
# Comma-separated prior keys accepted for reads during controlled rotation.
PFH_CHECKPOINT_HMAC_PREVIOUS_KEYS=

# deterministic | hosted-test | local-openai | disabled
PFH_AI_MODE=local-openai
PFH_LLM_BASE_URL=http://127.0.0.1:11434/v1
PFH_LLM_MODEL=qwen2.5:0.5b
# Synthetic developer pack only. Production activation requires an approved
# immutable model pack, its exact digest, license, evaluation and rollback.
PFH_LLM_MODEL_DIGEST=a8b0c51577010a279d933d14c2a8ab4b268079d44c5c8830c0a93900f1827c67
PFH_LLM_API_KEY=
PFH_LLM_TIMEOUT_MS=10000
PFH_LLM_DATA_CLASSIFICATION=synthetic-only
# Must be explicitly true before any synthetic demo may call a hosted model.
PFH_ALLOW_EXTERNAL_AI=false
# Used only by hosted-test. Prefer a secret manager or shell injection; never commit a key.
OPENAI_API_KEY=
# Exact reviewed origins for named/TLS on-prem endpoints, comma-separated.
PFH_LOCAL_AI_ALLOWED_ORIGINS=

# Separate deep-model path for grounded answers from the approved local corpus.
# deterministic | hosted-test (synthetic demo only) | local-openai
PFH_DEEP_LLM_MODE=local-openai
PFH_DEEP_LLM_BASE_URL=http://127.0.0.1:11434/v1
PFH_DEEP_LLM_MODEL=qwen2.5:0.5b
PFH_DEEP_LLM_MODEL_DIGEST=a8b0c51577010a279d933d14c2a8ab4b268079d44c5c8830c0a93900f1827c67
PFH_DEEP_LLM_API_KEY=
PFH_DEEP_LLM_TIMEOUT_MS=15000

# disabled | browser-demo (synthetic demo only) | hosted-test (synthetic only) | local-openai
PFH_ASR_MODE=local-openai
PFH_ASR_BASE_URL=
PFH_ASR_MODEL=whisper-large-v3-turbo
PFH_ASR_MODEL_DIGEST=a8b0c51577010a279d933d14c2a8ab4b268079d44c5c8830c0a93900f1827c67
PFH_ASR_API_KEY=

